{
  "version": "0.1.0",
  "app": "bionodulo",
  "name": "FASTQ QC pipeline",
  "description": "Run FastQC before and after trimming, then aggregate reports with MultiQC.",
  "nodes": [
    {
      "id": "input-fastq-1",
      "type": "input_fastq",
      "position": { "x": 80, "y": 220 },
      "params": {
        "files": [
          "examples/data/sample_R1.fastq.gz",
          "examples/data/sample_R2.fastq.gz"
        ]
      },
      "node_info": {
        "display_name": "Input FASTQ",
        "category": "Input",
        "version": "0.1.0",
        "package": "bionodulo-core",
        "required_executables": []
      }
    },
    {
      "id": "fastqc-raw-1",
      "type": "fastqc",
      "position": { "x": 380, "y": 140 },
      "params": {
        "threads": 4
      },
      "node_info": {
        "display_name": "FastQC",
        "category": "Quality Control",
        "version": "0.1.0",
        "package": "bionodulo-core",
        "documentation_url": "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/",
        "required_executables": ["fastqc"]
      }
    },
    {
      "id": "fastp-1",
      "type": "fastp",
      "position": { "x": 680, "y": 220 },
      "params": {
        "threads": 4
      },
      "node_info": {
        "display_name": "fastp",
        "category": "Read preprocessing",
        "version": "0.1.0",
        "package": "bionodulo-core",
        "documentation_url": "https://github.com/OpenGene/fastp",
        "required_executables": ["fastp"]
      }
    },
    {
      "id": "fastqc-trimmed-1",
      "type": "fastqc",
      "position": { "x": 980, "y": 220 },
      "params": {
        "threads": 4
      },
      "node_info": {
        "display_name": "FastQC",
        "category": "Quality Control",
        "version": "0.1.0",
        "package": "bionodulo-core",
        "documentation_url": "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/",
        "required_executables": ["fastqc"]
      }
    },
    {
      "id": "collect-qc-1",
      "type": "collect_files",
      "position": { "x": 1280, "y": 155 },
      "params": {},
      "node_info": {
        "display_name": "Collect Files",
        "category": "Utility",
        "version": "0.1.0",
        "package": "bionodulo-core",
        "required_executables": []
      }
    },
    {
      "id": "multiqc-1",
      "type": "multiqc",
      "position": { "x": 1580, "y": 180 },
      "params": {},
      "node_info": {
        "display_name": "MultiQC",
        "category": "Quality Control",
        "version": "0.1.0",
        "package": "bionodulo-core",
        "documentation_url": "https://multiqc.info/",
        "required_executables": ["multiqc"]
      }
    }
  ],
  "edges": [
    {
      "id": "edge-input-fastqc",
      "from": { "node": "input-fastq-1", "output": "reads" },
      "to": { "node": "fastqc-raw-1", "input": "reads" }
    },
    {
      "id": "edge-fastqc-fastp",
      "from": { "node": "fastqc-raw-1", "output": "reads" },
      "to": { "node": "fastp-1", "input": "reads" }
    },
    {
      "id": "edge-fastp-fastqc",
      "from": { "node": "fastp-1", "output": "trimmed_reads" },
      "to": { "node": "fastqc-trimmed-1", "input": "reads" }
    },
    {
      "id": "edge-raw-qc-collect",
      "from": { "node": "fastqc-raw-1", "output": "report_dir" },
      "to": { "node": "collect-qc-1", "input": "first" }
    },
    {
      "id": "edge-trimmed-qc-collect",
      "from": { "node": "fastqc-trimmed-1", "output": "report_dir" },
      "to": { "node": "collect-qc-1", "input": "second" }
    },
    {
      "id": "edge-collect-multiqc",
      "from": { "node": "collect-qc-1", "output": "directory" },
      "to": { "node": "multiqc-1", "input": "reports" }
    }
  ],
  "outputs": [
    "multiqc-1"
  ],
  "environment": {
    "type": "conda",
    "name": "bionodulo-fastq-qc",
    "file": "envs/fastq-qc.yaml",
    "image": null,
    "channels": ["conda-forge", "bioconda"],
    "packages": ["fastqc", "fastp", "multiqc"],
    "pip": [],
    "mounts": [],
    "notes": "Mock mode works without installing these tools; real mode expects them in the selected runtime."
  },
  "dependencies": {
    "schema_version": "0.1.0",
    "node_types": ["collect_files", "fastp", "fastqc", "input_fastq", "multiqc"],
    "node_packages": [
      { "name": "bionodulo-core", "version": "0.1.0" }
    ],
    "external_tools": [
      { "name": "fastqc", "version": "unknown", "executable": "fastqc" },
      { "name": "fastp", "version": "unknown", "executable": "fastp" },
      { "name": "multiqc", "version": "unknown", "executable": "multiqc" }
    ]
  }
}
