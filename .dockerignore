# The generic worker materializes workflow environments from committed locks.
# Keep root runtime caches excluded while retaining those lock bundles.
!bionodulo/environments/
!bionodulo/environments/**
SPEC.md
examples/
*.fq
*.fastq
*.fna
*.fasta
r_plot/

# --- worker image slimming: exclude non-engine dirs (worker runs `bionodulo/`) ---
desktop/
web/
tests/
docs/
templates/
.superpowers/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.md
uv.lock

# Re-include the template fixture data (244 KB). templates/ and the sequence
# file extensions above are excluded, and last match wins, so these negations
# must stay at the end. The worker needs these paths: a few template inputs are
# synthetic files with no public upstream (a counts matrix keyed by `gene`, a
# decoy-tagged protein database, an sgRNA library), and without them the run
# fails with "Source not found: /tmp/workspace/templates/data/...".
!templates/data/
!templates/data/**

# The root Dockerfile needs these, and the broad `web/` and `*.md` exclusions
# above would starve it: stage 1 copies web/ to build the frontend, and
# `pip install .` reads README.md + LICENSE for the wheel metadata. Last match
# wins, so re-exclude the heavy web subdirectories AFTER re-including web/.
!README.md
!LICENSE
!web/
!web/**
web/node_modules/
web/dist/
web/.next/
