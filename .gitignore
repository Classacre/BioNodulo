**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.log
**/.venv/

# Frontend build artifacts (hashed filenames change every build)
web/node_modules/
web/dist/
*.tsbuildinfo

# Local configuration and scratch output
.env
.env.*
!.env.example
.tmp*
*.tmp
*.bak
.coverage
.coverage.*
htmlcov/

# Retired static registry export; the editor uses the paginated API
web/public/biotools-registry/

# Runtime data
runs/
cache/
/best_so_far/
workspace/*
!workspace/.gitkeep
envs/
environments/*
!environments/.gitkeep

# User custom nodes (keep only examples)
custom_nodes/*/
!custom_nodes/example_node.py.example

# Test data / generated files
*.fq
*.fastq
*.fna
*.fasta
r_plot/
.pixi/
server.pid

# Example template data (large files; user downloads via Getting Started)
examples/data/

# Tiny deterministic fixtures used by official-template smoke defaults
!templates/data/smoke/
!templates/data/smoke/*.fastq
!templates/data/smoke/*.fasta

# Ad-hoc QA / screenshot output produced by local tooling
artifacts/
output/

# Playwright run artifacts
web/test-results/
web/playwright-report/
nohup.out

# Isolated implementation worktrees
.worktrees/
reports/biotools_registry/registry_snapshot.jsonl
reports/biotools_registry/current/
