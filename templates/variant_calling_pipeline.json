      },
      "to": {
        "node": "index_001",
        "input": "bam"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "index_001",
        "output": "indexed_bam"
      },
      "to": {
        "node": "gatk_001",
        "input": "bam"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "ref_001",
        "output": "reference"
      },
      "to": {
        "node": "gatk_001",
        "input": "reference"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "gatk_001",
        "output": "variants"
      },
      "to": {
        "node": "filter_001",
        "input": "vcf"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "index_001",
        "output": "indexed_bam"
      },
      "to": {
        "node": "flagstat_001",
        "input": "bam"
      }
    },
    {
      "id": "e9",
      "from": {
        "node": "reads_001",
        "output": "reads"
      },
      "to": {
        "node": "qc_001",
        "input": "reads"
      }
    },
    {
      "id": "e10",
      "from": {
        "node": "qc_001",
        "output": "report_dir"
      },
      "to": {
        "node": "mqc_001",
        "input": "reports"
      }
    }
  ],
  "groups": [],
