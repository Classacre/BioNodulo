{
  "version": "Alpha 1.2",
  "app": "bionodulo",
  "name": "Variant Calling Pipeline",
  "description": "GATK-based germline variant calling from FASTQ to filtered VCF",
  "nodes": [
    {
      "id": "note_variant_calling_pipeline",
      "type": "note",
      "position": [
        -270,
        200
      ],
      "params": {
        "text": "Variant calling pipeline: aligns with BWA-MEM, processes BAM, and calls variants with GATK/bcftools.\n\nData source:\n- Reads: Staphylococcus aureus mutant paired-end WGS (12,480 read pairs)\n  Zenodo: https://zenodo.org/record/582600\n  Files: mutant_R1.fastq (3.9M), mutant_R2.fastq (3.9M)\n- Reference: S. aureus wildtype genome (200,684 bp, 1 contig)\n  Zenodo: https://zenodo.org/record/582600\n  File: wildtype.fna (196K)\n- Galaxy Training Material: Microbial Variant Calling tutorial\n  https://training.galaxyproject.org/training-material/topics/variant-analysis/tutorials/microbial-variants/tutorial.html\nNote: This is a demonstration dataset. For real analysis, use appropriate reference genomes and databases."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "reads_001",
      "type": "input_fastq",
      "position": [
        50,
        50
      ],
      "params": {
        "sample_name": "sample1",
        "paired_end": true,
        "reads": [
          "examples/data/variant_calling/mutant_R1.fastq",
          "examples/data/variant_calling/mutant_R2.fastq"
        ]
      },
      "ui": {
        "title": "Input FASTQ"
      }
    },
    {
      "id": "ref_001",
      "type": "input_fasta",
      "position": [
        50,
        180
      ],
      "params": {
        "file_path": "examples/data/variant_calling/wildtype.fna",
        "reference": "examples/data/variant_calling/wildtype.fna"
      },
      "ui": {
        "title": "Reference FASTA"
      }
    },
    {
      "id": "bwa_001",
      "type": "bwa_mem",
      "position": [
        300,
        50
      ],
      "params": {
        "threads": 8,
        "mark_shorter_splits": true
      },
      "ui": {
        "title": "BWA-MEM"
      }
    },
    {
      "id": "sort_001",
      "type": "samtools_sort",
      "position": [
        550,
        50
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "samtools sort"
      }
    },
    {
      "id": "index_001",
      "type": "samtools_index",
      "position": [
        550,
        200
      ],
      "params": {},
      "ui": {
        "title": "samtools index"
      }
    },
    {
      "id": "flagstat_001",
      "type": "samtools_flagstat",
      "position": [
        550,
        350
      ],
      "params": {},
      "ui": {
        "title": "samtools flagstat"
      }
    },
    {
      "id": "gatk_001",
      "type": "gatk_haplotypecaller",
      "position": [
        800,
        50
      ],
      "params": {
        "emit_conf": 30,
        "call_conf": 30
      },
      "ui": {
        "title": "GATK HaplotypeCaller"
      }
    },
    {
      "id": "filter_001",
      "type": "bcftools_filter",
      "position": [
        1050,
        50
      ],
      "params": {
        "expr": "QUAL>30 && DP>10"
      },
      "ui": {
        "title": "bcftools filter"
      }
    },
    {
      "id": "qc_001",
      "type": "fastqc",
      "position": [
        300,
        350
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "FastQC"
      }
    },
    {
      "id": "mqc_001",
      "type": "multiqc",
      "position": [
        800,
        350
      ],
      "params": {
        "title": "Variant Calling QC"
      },
      "ui": {
        "title": "MultiQC"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "reads_001",
        "output": "reads"
      },
      "to": {
        "node": "bwa_001",
        "input": "reads"
      }
    },
    {
      "id": "e2",
      "from": {
