{
  "version": "2.0",
  "app": "bionodulo",
  "name": "WGS Variant Pipeline",
  "description": "Whole genome sequencing variant calling with BWA and FreeBayes",
  "parameters": [
    {
      "name": "snpeff_genome",
      "type": "STRING",
      "required": false,
      "default": "Wildtype",
      "description": "Identifier the in-workflow SnpEff database is registered under; any valid SnpEff id works because the database is built here, not fetched from SnpEff's registry"
    }
  ],
  "nodes": [
    {
      "id": "note_wgs_variant_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "WGS variant pipeline: complete germline variant discovery from whole-genome sequencing data.\n\nData source: Galaxy Training variant-calling tutorial (Zenodo 582600) --\nStaphylococcus aureus wildtype reference (wildtype.fna, 197 kb, single contig\n'Wildtype') with its Prokka annotation (wildtype.gff, 167 CDS) and 12,480\npaired 150 bp mutant reads.\n\nReads and reference are the SAME organism -- verified 100% of a 10k-read\nsubset aligns. The previous pairing used sarscov2 reads against an E. coli\nreference and mapped 0%.\n\nThe SnpEff database is BUILT in-workflow from this reference + annotation, so\nthe pipeline needs no pre-published SnpEff genome and no user-supplied file."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "reads_001",
      "type": "input_fastq",
      "position": [
        80,
        80
      ],
      "params": {
        "sample_name": "mutant",
        "reads": [
          "https://zenodo.org/record/582600/files/mutant_R1.fastq",
          "https://zenodo.org/record/582600/files/mutant_R2.fastq"
        ]
      },
      "ui": {
        "title": "Input FASTQ",
        "validation": {
          "outputs": {
            "reads": {
              "expected_format": "fastq",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "ref_001",
      "type": "input_fasta",
      "position": [
        80,
        270
      ],
      "params": {
        "reference": "https://zenodo.org/record/582600/files/wildtype.fna"
      },
      "ui": {
        "title": "Reference FASTA",
        "validation": {
          "outputs": {
            "reference": {
              "expected_format": "fasta",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
