{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Synthetic Biology Design and Simulation",
  "description": "BioCAD workflow template that validates SBOL, COPASI, COMBINE archive, and Cello inputs; imports and summarizes SBOL designs; runs COPASI and iBioSim simulation branches; compiles a Cello circuit design; and collects TSV result summaries into an HTML report.",
  "category": "Synthetic Biology",
  "tags": [
    "synthetic-biology",
    "sbol",
    "biocad",
    "cello",
    "copasi",
    "ibiosim",
    "sed-ml",
    "combine-archive"
  ],
  "tools": [
    "input_file",
    "input_directory",
    "sbol_design_import",
    "copasi_simulation",
    "ibiosim_model",
    "cello_circuit_design"
  ],
  "nodes": [
    {
      "id": "note_synthetic_biology_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Synthetic biology BioCAD workflow: validate SBOL, COPASI, COMBINE archive, and Cello inputs; import and summarize the SBOL design; run COPASI and iBioSim simulation branches; run a Cello circuit design branch; then collect TSV result summaries into an HTML report.\n\nInputs are placeholders. COPASI, iBioSim, and Cello require local executables or installations that are not automatically installed by conda in this template."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "sbol_design_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/synthetic_biology/toggle_switch.xml"
      },
      "ui": {
        "title": "SBOL Design",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
