{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Synthetic Biology Design and Simulation",
  "description": "BioCAD template with source-pinned SBOL normalization, COPASI and iBioSim simulation branches, and a Cello v2 DNACompiler branch with every required design artifact represented explicitly.",
  "category": "Synthetic Biology",
  "tags": [
    "synthetic-biology",
    "sbol",
    "biocad",
    "cello",
    "copasi",
    "ibiosim",
    "sed-ml",
    "combine-archive"
  ],
  "tools": [
    "input_file",
    "sbol_design_import",
    "copasi_simulation",
    "ibiosim_model",
    "cello_circuit_design"
  ],
  "nodes": [
    {
      "id": "note_synthetic_biology_pipeline",
      "type": "note",
      "position": [-260, 80],
      "params": {
        "text": "Synthetic-biology template with independent SBOL, COPASI, iBioSim, and Cello branches. Input paths are placeholders. COPASI and the case-sensitive iBioSim wrapper must be provisioned in the worker image. Cello additionally requires a pinned DNACompiler JAR plus Java, Python, Yosys, and Graphviz."
      },
      "ui": {
        "title": "Runtime Requirements",
        "color": "#f59e0b"
      }
    },
    {
      "id": "sbol_design_001",
      "type": "input_file",
      "position": [80, 80],
      "params": {
        "file": "examples/data/synthetic_biology/toggle_switch.xml"
      },
      "ui": {
        "title": "SBOL Design",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
