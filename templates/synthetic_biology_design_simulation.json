{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Synthetic Biology Design and Simulation",
  "description": "SBOL 3 design import and a COPASI time-course simulation of a published model",
  "category": "Synthetic Biology",
  "tags": [
    "synthetic-biology",
    "sbol",
    "biocad",
    "cello",
    "copasi",
    "ibiosim",
    "sed-ml",
    "combine-archive"
  ],
  "tools": [
    "copasi_simulation",
    "input_file",
    "note",
    "sbol_design_import"
  ],
  "nodes": [
    {
      "id": "note_synthetic_biology_pipeline",
      "type": "note",
      "position": [
        -260,
        80
      ],
      "params": {
        "text": "Synthetic-biology template with two independent branches: an SBOL 3 design import via pySBOL3, and a COPASI time-course simulation of a published model.\n\nThe iBioSim and Cello branches were removed because neither tool can be obtained by an automated pipeline:\n- Cello publishes NO release asset at all. CIDARLAB/Cello-v2 v0.1 has an empty assets list, there is no cello-dnacompiler JAR anywhere, and neither bioconda nor conda-forge carries it. Its only distribution is a Docker image.\n- iBioSim ships iBioSim-linux64.zip, but its launcher is a cwd-dependent shell script ending in  with no arguments, i.e. the GUI. There is no headless CLI to drive.\n\nCOPASI has no conda package either, so CopasiSE is provisioned from the vendor Build-298 AllSE archive - the newest release that ships an extractable binary rather than an installer.\n\nData: SBOLTestSuite toggle_switch.rdf (SBOL 3, pinned to a commit SHA) and BioModels BIOMD0000000012 (Elowitz & Leibler repressilator)."
      },
      "ui": {
        "title": "Runtime Requirements",
        "color": "#f59e0b"
      }
    },
    {
      "id": "sbol_design_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "https://raw.githubusercontent.com/SynBioDex/SBOLTestSuite/0044284331b2f915a6e4b9d50e1cbf3ea2f62dcd/SBOL3/toggle_switch/toggle_switch.rdf",
        "source": "url"
      },
      "ui": {
        "title": "SBOL Design",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "sbol_import_001",
      "type": "sbol_design_import",
      "position": [
        460,
        80
      ],
      "params": {
        "namespace": "https://bionodulo.local/synthetic-biology",
        "validate": true,
        "output_format": "xml"
      },
      "ui": {
        "title": "SBOL Design Import",
        "validation": {
          "outputs": {
            "normalized_sbol": {
              "expected_format": "xml",
              "min_size_bytes": 1,
              "fail_on_error": true
            },
            "summary": {
              "expected_format": "json",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "copasi_model_001",
      "type": "input_file",
      "position": [
        80,
        250
      ],
      "params": {
        "file": "https://www.ebi.ac.uk/biomodels/model/download/BIOMD0000000012?filename=BIOMD0000000012_url.xml",
        "source": "url"
      },
      "ui": {
        "title": "COPASI CPS Model",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "copasi_simulation_001",
      "type": "copasi_simulation",
      "position": [
        460,
        250
      ],
      "params": {
        "input_format": "sbml",
        "scheduled_task": "Time-Course",
        "sedml_task": "",
        "verbose": false,
        "max_time": 600
      },
      "ui": {
        "title": "COPASI Simulation",
        "validation": {
          "outputs": {
            "report": {
              "expected_format": "text",
              "min_size_bytes": 1,
              "fail_on_error": true
            },
            "updated_model": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e_sbol",
      "from": {
        "node": "sbol_design_001",
        "output": "file"
      },
      "to": {
        "node": "sbol_import_001",
        "input": "sbol_file"
      }
    },
    {
      "id": "e_copasi",
      "from": {
        "node": "copasi_model_001",
        "output": "file"
      },
      "to": {
        "node": "copasi_simulation_001",
        "input": "model_file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "sbol_design": "sbol_design_001",
    "sbol_document": "sbol_import_001",
    "copasi_model": "copasi_model_001",
    "copasi_report": "copasi_simulation_001",
    "copasi_updated_model": "copasi_simulation_001",
    "copasi_log": "copasi_simulation_001"
  }
}