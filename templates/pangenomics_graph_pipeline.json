{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Pangenomics Graph QC and Visualization",
  "description": "Pangenomics workflow template that validates a multi-sequence haplotype FASTA, builds a reference-free PGGB graph, validates the GFA output, runs ODGI build and stats, and renders a graph visualization.",
  "category": "Pangenomics",
  "tags": [
    "pangenomics",
    "pangenome",
    "pggb",
    "odgi",
    "graph",
    "qc",
    "visualization"
  ],
  "tools": [
    "input_fasta",
    "pggb",
    "odgi_build",
    "odgi_viz",
    "odgi_stats",
    "image_preview"
  ],
  "nodes": [
    {
      "id": "note_pangenomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Pangenomics graph workflow: validate a multi-sequence haplotype FASTA, build a reference-free graph with PGGB, validate the GFA, build and summarize the graph with ODGI, and render a graph image.\n\nThe bundled PGGB v0.7.4 HLA-DRB1 fixture contains 12 non-PanSN sequences, so num_haplotypes is explicitly set to 12. Replace the FASTA and update num_haplotypes together for other datasets. PGGB's built-in diagnostic rendering is disabled because the dedicated ODGI Viz node produces the declared visualization artifact."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "haplotypes_001",
      "type": "input_fasta",
      "position": [
        80,
        80
      ],
      "params": {
        "reference": "examples/data/pangenomics/haplotypes.fa"
      },
      "ui": {
        "title": "Haplotype FASTA",
        "validation": {
          "outputs": {
            "reference": {
              "expected_format": "fasta",
              "min_records": 12,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "pggb_001",
      "type": "pggb",
      "position": [
        440,
        80
      ],
      "params": {
        "num_haplotypes": 12,
        "threads": 16,
        "map_pct_id": 90,
        "segment_length": 5000,
        "min_match_length": 23,
        "poa_length_target": "700,1100",
        "do_viz": false
      },
      "ui": {
        "title": "PGGB Build",
        "validation": {
          "outputs": {
            "smooth_gfa": {
              "expected_format": "text",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "odgi_build_001",
      "type": "odgi_build",
      "position": [
        800,
        80
      ],
      "params": {
        "threads": 8,
        "compact_ids": true,
        "validate": true,
        "output_name": "pangenome_graph"
      },
      "ui": {
        "title": "ODGI Build",
        "validation": {
          "outputs": {
            "stats": {
              "expected_format": "json",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "odgi_viz_001",
      "type": "odgi_viz",
      "position": [
        800,
        408
      ],
      "params": {
        "width": 1600,
        "height": 260,
        "show_paths": true,
        "viz_mode": "gradient",
        "threads": 8
      },
      "ui": {
        "title": "ODGI Viz"
      }
    },
    {
      "id": "odgi_stats_001",
      "type": "odgi_stats",
      "position": [
        800,
        782
      ],
      "params": {
        "threads": 8
      },
      "ui": {
        "title": "ODGI Stats",
        "validation": {
          "outputs": {
            "stats_json": {
              "expected_format": "json",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "graph_image_preview_001",
      "type": "image_preview",
      "position": [
        1160,
        80
      ],
      "params": {},
      "ui": {
        "title": "Preview Graph Image"
      }
    }
  ],
  "edges": [
    {
      "id": "e2",
      "from": {
        "node": "haplotypes_001",
        "output": "reference"
      },
      "to": {
        "node": "pggb_001",
        "input": "input_fasta"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "pggb_001",
        "output": "smooth_gfa"
      },
      "to": {
        "node": "odgi_build_001",
        "input": "gfa_graph"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "odgi_build_001",
        "output": "graph_odgi"
      },
      "to": {
        "node": "odgi_viz_001",
        "input": "gfa_graph"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "odgi_build_001",
        "output": "graph_odgi"
      },
      "to": {
        "node": "odgi_stats_001",
        "input": "gfa_graph"
      }
    },
    {
      "id": "e9",
      "from": {
        "node": "odgi_viz_001",
        "output": "viz_image"
      },
      "to": {
        "node": "graph_image_preview_001",
        "input": "file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "validated_haplotypes": "haplotypes_001",
    "pggb_graph": "pggb_001",
    "validated_graph_gfa": "pggb_001",
    "odgi_graph": "odgi_build_001",
    "odgi_build_stats": "odgi_build_001",
    "odgi_stats": "odgi_stats_001",
    "graph_visualization": "odgi_viz_001"
  }
}
