{
  "version": "2.0",
  "app": "bionodulo",
  "name": "FASTQ QC Pipeline",
  "description": "Quality control pipeline for sequencing reads using FastQC and MultiQC",
  "nodes": [
    {
      "id": "note_fastq_qc_pipeline",
      "type": "note",
      "position": [
        -300,
        80
      ],
      "params": {
        "text": "FASTQ quality control: trim paired reads with fastp, run FastQC, and aggregate the reports with MultiQC. Quality gates and preview nodes expose the resulting artifacts.\n\nThe default reads are the small Illumina test_1/test_2 FASTQs from the nf-core SARS-CoV-2 test-data collection, pinned to a repository revision. Replace both read inputs together for your own sample."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "input_fastq_001",
      "type": "input_fastq",
      "position": [
        80,
        278
      ],
      "params": {
        "sample_name": "sample1",
        "reads": [
          "https://raw.githubusercontent.com/nf-core/test-datasets/81ed58c830f2ef4640a5fd151968111dd8c5559d/data/genomics/sarscov2/illumina/fastq/test_1.fastq.gz",
          "https://raw.githubusercontent.com/nf-core/test-datasets/81ed58c830f2ef4640a5fd151968111dd8c5559d/data/genomics/sarscov2/illumina/fastq/test_2.fastq.gz"
        ]
      },
      "ui": {
        "title": "Input FASTQ",
        "validation": {
          "outputs": {
            "reads": {
              "expected_format": "fastq",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "fastqc_001",
      "type": "fastqc",
      "position": [
        800,
        228
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "FastQC"
      }
    },
    {
      "id": "fastp_001",
      "type": "fastp",
      "position": [
        440,
        230
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "fastp Trim"
      }
    },
    {
      "id": "multiqc_001",
      "type": "multiqc",
      "position": [
        1160,
        80
      ],
      "params": {
        "title": "QC Report"
      },
      "ui": {
        "title": "MultiQC"
      }
    },
    {
      "id": "html_preview_001",
      "type": "html_preview",
      "position": [
        1880,
        430
      ],
      "params": {},
      "ui": {
        "title": "View MultiQC Report"
      }
    },
    {
      "id": "validate_multiqc_001",
      "type": "data_validator",
      "position": [
        1520,
        136
      ],
      "params": {
        "expected_format": "text",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate MultiQC Report"
      }
    },
    {
      "id": "gate_multiqc_001",
      "type": "gate",
      "position": [
        1880,
        199
      ],
      "params": {
        "condition_mode": "boolean_is_true",
        "on_fail": "halt",
        "error_message": "MultiQC report validation failed"
      },
      "ui": {
        "title": "Gate Valid QC"
      }
    },
    {
      "id": "qc_dashboard_001",
      "type": "qc_dashboard",
      "position": [
        1160,
        339
      ],
      "params": {
        "run_name": "FastQ QC",
        "title": "FastQ QC Dashboard",
        "theme": "light"
      },
      "ui": {
        "title": "QC Dashboard"
      }
    },
    {
      "id": "qc_dashboard_preview_001",
      "type": "html_preview",
      "position": [
        1520,
        493
      ],
      "params": {},
      "ui": {
        "title": "View QC Dashboard"
      }
    }
  ],
  "edges": [
    {
      "id": "e1a",
      "from": {
        "node": "input_fastq_001",
        "output": "reads"
      },
      "to": {
        "node": "fastp_001",
        "input": "reads"
      }
    },
    {
      "id": "e1b",
      "from": {
        "node": "fastp_001",
        "output": "trimmed_reads"
      },
      "to": {
        "node": "fastqc_001",
        "input": "reads"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "fastqc_001",
        "output": "report_dir"
      },
      "to": {
        "node": "multiqc_001",
        "input": "reports"
      }
    },
    {
      "id": "e2a",
      "from": {
        "node": "fastp_001",
        "output": "json_report"
      },
      "to": {
        "node": "multiqc_001",
        "input": "reports"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "multiqc_001",
        "output": "report"
      },
      "to": {
        "node": "validate_multiqc_001",
        "input": "input"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "validate_multiqc_001",
        "output": "passed"
      },
      "to": {
        "node": "gate_multiqc_001",
        "input": "value"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "validate_multiqc_001",
        "output": "passthrough"
      },
      "to": {
        "node": "html_preview_001",
        "input": "file"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "fastqc_001",
        "output": "report_dir"
      },
      "to": {
        "node": "qc_dashboard_001",
        "input": "fastqc_dir"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "qc_dashboard_001",
        "output": "qc_dashboard"
      },
      "to": {
        "node": "qc_dashboard_preview_001",
        "input": "file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "report": "multiqc_001",
    "validated_report": "validate_multiqc_001",
    "trimmed_reads": "fastp_001",
    "validated_reads": "input_fastq_001",
    "qc_dashboard": "qc_dashboard_001"
  }
}
