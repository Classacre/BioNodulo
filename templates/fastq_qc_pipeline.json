{
  "version": "2.0",
  "app": "bionodulo",
  "name": "FASTQ QC Pipeline",
  "description": "Quality control pipeline for sequencing reads using FastQC and MultiQC",
  "nodes": [
    {
      "id": "note_fastq_qc_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "FASTQ quality control: trims reads with fastp, runs FastQC, and aggregates reports with MultiQC.\n\nData source: OpenGene fastp test data (https://github.com/OpenGene/fastp/tree/master/testdata). Small paired-end Illumina reads for demonstration.\nFiles: R1.fq (3,041 bytes), R2.fq (3,343 bytes)."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "input_fastq_001",
      "type": "input_fastq",
      "position": [
        80,
        80
      ],
      "params": {
        "sample_name": "sample1",
        "reads": [
          "https://github.com/OpenGene/fastp/raw/master/testdata/R1.fq",
          "https://github.com/OpenGene/fastp/raw/master/testdata/R2.fq"
        ]
      },
      "ui": {
        "title": "Input FASTQ"
      }
    },
    {
      "id": "fastqc_001",
      "type": "fastqc",
      "position": [
        1160,
        80
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "FastQC"
      }
    },
    {
      "id": "fastp_001",
      "type": "fastp",
      "position": [
        800,
        80
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "fastp Trim"
      }
    },
    {
      "id": "validate_reads_001",
      "type": "data_validator",
      "position": [
        440,
        80
      ],
      "params": {
        "expected_format": "fastq",
        "min_records": 1,
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate FASTQ Reads"
      }
    },
    {
      "id": "multiqc_001",
      "type": "multiqc",
      "position": [
        1520,
        80
      ],
      "params": {
        "title": "QC Report"
      },
      "ui": {
        "title": "MultiQC"
      }
    },
    {
      "id": "html_preview_001",
      "type": "html_preview",
      "position": [
        2240,
        80
      ],
      "params": {},
      "ui": {
        "title": "View MultiQC Report"
      }
    },
    {
      "id": "validate_multiqc_001",
      "type": "data_validator",
      "position": [
        1880,
        80
      ],
      "params": {
        "expected_format": "text",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate MultiQC Report"
      }
    },
    {
      "id": "gate_multiqc_001",
      "type": "gate",
      "position": [
        2060,
        220
      ],
      "params": {
        "condition_mode": "boolean_is_true",
        "on_fail": "halt",
        "error_message": "MultiQC report validation failed"
      },
      "ui": {
        "title": "Gate Valid QC"
      }
    },
    {
      "id": "qc_dashboard_001",
      "type": "qc_dashboard",
      "position": [
        1520,
        300
      ],
      "params": {
        "run_name": "FastQ QC",
        "title": "FastQ QC Dashboard",
        "theme": "light"
      },
      "ui": {
        "title": "QC Dashboard"
      }
    },
    {
      "id": "qc_dashboard_preview_001",
      "type": "html_preview",
      "position": [
        1880,
        300
      ],
      "params": {},
      "ui": {
        "title": "View QC Dashboard"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "input_fastq_001",
        "output": "reads"
      },
      "to": {
        "node": "validate_reads_001",
        "input": "input"
      }
    },
    {
      "id": "e1a",
      "from": {
        "node": "validate_reads_001",
        "output": "passthrough"
      },
      "to": {
        "node": "fastp_001",
        "input": "reads"
      }
    },
    {
      "id": "e1b",
      "from": {
        "node": "fastp_001",
        "output": "trimmed_reads"
      },
      "to": {
        "node": "fastqc_001",
        "input": "reads"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "fastqc_001",
        "output": "report_dir"
      },
      "to": {
        "node": "multiqc_001",
        "input": "reports"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "multiqc_001",
        "output": "report"
      },
      "to": {
        "node": "validate_multiqc_001",
        "input": "input"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "validate_multiqc_001",
        "output": "passed"
      },
      "to": {
        "node": "gate_multiqc_001",
        "input": "value"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "validate_multiqc_001",
        "output": "passthrough"
      },
      "to": {
        "node": "html_preview_001",
        "input": "file"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "fastqc_001",
        "output": "report_dir"
      },
      "to": {
        "node": "qc_dashboard_001",
        "input": "fastqc_dir"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "qc_dashboard_001",
        "output": "qc_dashboard"
      },
      "to": {
        "node": "qc_dashboard_preview_001",
        "input": "file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "report": "multiqc_001",
    "validated_report": "validate_multiqc_001",
    "trimmed_reads": "fastp_001",
    "validated_reads": "validate_reads_001",
    "qc_dashboard": "qc_dashboard_001"
  }
}
