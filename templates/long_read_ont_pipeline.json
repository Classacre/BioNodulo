{
  "version": "2.0",
  "app": "bionodulo",
  "name": "ONT Long-Read Sequencing",
  "description": "Oxford Nanopore basecalling with staged local models, explicit reference and BAM sidecars, barcode demultiplexing, source-native selected-barcode conversion, filtering, QC, and modified-base methylation pileup.",
  "category": "Long Read",
  "tags": [
    "long-read",
    "nanopore",
    "ont",
    "dorado",
    "modkit",
    "methylation",
    "qc"
  ],
