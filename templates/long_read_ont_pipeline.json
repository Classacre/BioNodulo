    "data_validator",
    "chopper_filter",
    "nanoplot",
    "modkit_pileup",
    "table_preview"
  ],
  "nodes": [
    {
      "id": "note_long_read_pipeline",
      "type": "note",
      "position": [
        -300,
        80
      ],
      "params": {
        "text": "ONT example: basecall 100 POD5 reads on CPU with staged fast and 5mCG models, align to hg38 chr22, filter reads, inspect NanoPlot QC, and pile up CpG methylation.\n\nCPU is explicit for this small demonstration and is slower than GPU basecalling. For larger data, select auto/CUDA and supported GPU compute. GPU runs remain subject to provider availability.\n\nSource: nf-core/test-datasets test.pod5, R9.4.1 4 kHz, SQK-LSK109. Its upstream sarscov2 folder name is misleading: prior checks identify human chr22 reads. The short, low-quality subset illustrates execution; it does not validate methylation accuracy. Chopper Q7 / 200 bp thresholds retain useful reads."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "pod5_001",
      "type": "input_directory",
      "position": [
        80,
        229
      ],
      "params": {
        "directory": "https://raw.githubusercontent.com/nf-core/test-datasets/e89cc625a41689dc9d0abf50289ec90aa9284b19/data/genomics/sarscov2/nanopore/pod5/test.pod5",
        "source": "url"
      },
      "ui": {
        "title": "POD5 Directory",
        "validation": {
          "outputs": {
            "directory": {
              "expected_format": "directory",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
