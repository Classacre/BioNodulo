    "data_validator",
    "chopper_filter",
    "nanoplot",
    "modkit_pileup",
    "table_preview"
  ],
  "nodes": [
    {
      "id": "note_long_read_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "ONT long-read workflow: stages explicit local Dorado simplex and modified-base model directories, prepares colocated FASTA sidecars, basecalls to a sorted BAM/BAI pair, splits existing barcode classifications with Dorado demux in BAM mode, selects exactly one source-native barcode BAM, converts it to FASTQ with Samtools Fastx, validates that FASTQ, filters it with Chopper, runs NanoPlot QC, and generates a CpG-aware Modkit bedMethyl pileup.\n\nInputs are placeholders. Point the POD5, model, and reference inputs at staged local artifacts before execution. The selected_barcode value must equal the Dorado BC tag (or sample-sheet alias) to process; the default follows the configured SQK-NBD114-24 kit."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "pod5_001",
      "type": "input_directory",
      "position": [
        80,
        80
      ],
      "params": {
        "directory": "examples/data/long_read/pod5"
      },
      "ui": {
        "title": "POD5 Directory",
        "validation": {
          "outputs": {
            "directory": {
              "expected_format": "directory",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
