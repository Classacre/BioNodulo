        "title": "Validate MethylDackel BedGraph"
      }
    },
    {
      "id": "wgbs_report_001",
      "type": "html_report",
      "position": [
        1520,
        160
      ],
      "params": {
        "title": "WGBS Methylation Profiling Report",
        "text_sections": "# Summary\nValidated WGBS reads are aligned with Bismark and processed through Bismark methylation extractor and MethylDackel to produce methylation calls for downstream analysis.",
        "section_names": "Bismark methylation output,MethylDackel bedGraph"
      },
      "ui": {
        "title": "WGBS Report"
      }
    },
    {
