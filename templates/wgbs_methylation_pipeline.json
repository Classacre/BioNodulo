{
  "version": "2.0",
  "app": "bionodulo",
  "name": "WGBS Methylation Profiling",
  "description": "Whole-genome bisulfite sequencing workflow that validates paired FASTQ, Bismark genome, and reference FASTA inputs, aligns reads with Bismark, explicitly sorts and indexes the MethylDackel BAM, prepares the reference FAI, and extracts methylation calls with Bismark and MethylDackel.",
  "category": "Epigenomics",
  "tags": [
    "epigenomics",
    "wgbs",
    "bisulfite",
    "bismark",
    "methyldackel",
    "methylation"
  ],
  "tools": [
    "input_file",
    "input_directory",
    "input_fasta",
    "bismark_align",
    "gate",
    "samtools_sort",
    "samtools_index",
    "samtools_faidx",
    "bismark_methylation_extractor",
    "methyldackel"
  ],
  "nodes": [
    {
      "id": "note_wgbs_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "WGBS methylation workflow: validate paired FASTQ reads, Bismark-prepared genome folder, and reference FASTA; align with Bismark; gate the aligned BAM; coordinate-sort and index the MethylDackel branch; build the reference FAI; then run Bismark methylation extractor and MethylDackel.\n\nInputs are placeholders. Point R1/R2 FASTQ, genome folder, and reference FASTA at local WGBS data before execution."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
