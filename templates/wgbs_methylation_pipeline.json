{
  "version": "2.0",
  "app": "bionodulo",
  "name": "WGBS Methylation Profiling",
  "description": "Whole-genome bisulfite sequencing workflow that validates paired FASTQ, Bismark genome, and reference FASTA inputs, aligns reads with Bismark, gates the aligned BAM, extracts methylation calls with Bismark and MethylDackel, and generates an HTML methylation report.",
  "category": "Epigenomics",
  "tags": [
    "epigenomics",
    "wgbs",
    "bisulfite",
    "bismark",
    "methyldackel",
    "methylation"
  ],
  "tools": [
    "input_file",
    "input_directory",
    "input_fasta",
    "data_validator",
    "bismark_align",
    "gate",
    "bismark_methylation_extractor",
    "methyldackel",
    "html_report",
    "html_preview"
  ],
  "nodes": [
    {
      "id": "note_wgbs_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "WGBS methylation workflow: validate paired FASTQ reads, Bismark-prepared genome folder, and reference FASTA; align with Bismark; gate the aligned BAM before methylation extraction; run both Bismark methylation extractor and MethylDackel; then generate an HTML report.\n\nInputs are placeholders. Point R1/R2 FASTQ, genome folder, and reference FASTA at local WGBS data before execution."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
