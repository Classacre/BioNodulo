{
  "version": "2.0",
  "app": "bionodulo",
  "name": "WGBS Methylation Profiling",
  "description": "Whole-genome bisulfite sequencing workflow that validates paired FASTQ, Bismark genome, and reference FASTA inputs, aligns reads with Bismark, gates the aligned BAM, extracts methylation calls with Bismark and MethylDackel, and generates an HTML methylation report.",
  "category": "Epigenomics",
  "tags": [
    "epigenomics",
    "wgbs",
    "bisulfite",
    "bismark",
    "methyldackel",
    "methylation"
  ],
  "tools": [
    "input_file",
    "input_directory",
    "input_fasta",
    "bismark_align",
    "gate",
    "bismark_methylation_extractor",
    "methyldackel"
  ],
  "nodes": [
    {
      "id": "note_wgbs_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "WGBS methylation workflow: validate paired FASTQ reads, Bismark-prepared genome folder, and reference FASTA; align with Bismark; gate the aligned BAM before methylation extraction; run both Bismark methylation extractor and MethylDackel; then generate an HTML report.\n\nInputs are placeholders. Point R1/R2 FASTQ, genome folder, and reference FASTA at local WGBS data before execution."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "r1_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/epigenomics/sample_R1.fastq.gz"
      },
      "ui": {
        "title": "R1 FASTQ",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "fastq",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "r2_001",
      "type": "input_file",
      "position": [
        80,
        231
      ],
      "params": {
        "file": "examples/data/epigenomics/sample_R2.fastq.gz"
      },
      "ui": {
        "title": "R2 FASTQ",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "fastq",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "genome_001",
      "type": "input_directory",
      "position": [
        80,
        382
      ],
      "params": {
        "directory": "examples/data/epigenomics/bismark_genome"
      },
      "ui": {
        "title": "Bismark Genome Folder",
        "validation": {
          "outputs": {
            "directory": {
              "expected_format": "directory",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "reference_001",
      "type": "input_fasta",
      "position": [
        80,
        533
      ],
      "params": {
        "reference": "examples/data/epigenomics/reference.fasta"
      },
      "ui": {
        "title": "Reference FASTA",
        "validation": {
          "outputs": {
            "reference": {
              "expected_format": "fasta",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "bismark_align_001",
      "type": "bismark_align",
      "position": [
        440,
        80
      ],
      "params": {
        "parallel_instances": 4,
        "non_directional": false
      },
      "ui": {
        "title": "Bismark Align"
      }
    },
    {
      "id": "gate_bismark_bam_001",
      "type": "gate",
      "position": [
        800,
        80
      ],
      "params": {
        "condition_mode": "file_exists",
        "on_fail": "halt",
        "error_message": "Bismark aligned BAM is required before methylation extraction"
      },
      "ui": {
        "title": "Gate Bismark BAM"
      }
    },
    {
      "id": "bismark_methylation_001",
      "type": "bismark_methylation_extractor",
      "position": [
        1160,
        80
      ],
      "params": {
        "multicore": 4,
        "cytosine_report": true,
        "no_overlap": true,
        "merge_non_cpg": false
      },
      "ui": {
        "title": "Bismark Methylation Extractor",
        "validation": {
          "outputs": {
            "methylation_output": {
              "expected_format": "directory",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "methyldackel_001",
      "type": "methyldackel",
      "position": [
        1160,
        430
      ],
      "params": {
        "output_prefix": "wgbs_methyldackel",
        "merge_context": true,
        "min_depth": 1
      },
      "ui": {
        "title": "MethylDackel",
        "validation": {
          "outputs": {
            "methylation_bedgraph": {
              "expected_format": "text",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
