    {
      "id": "note_metagenomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Metagenomics pipeline: classifies taxa with Kraken2/Bracken and profiles functions with HUMAnN.\n\nData source: Zenodo record 17661262 (Galaxy Training Network).\nreads_forward.fastq (3.0M), reads_reverse.fastq (3.0M).\nCoffee fermentation metagenome subset for assembly tutorial.\nURL: https://zenodo.org/records/17661262\nNote: Kraken2 database directory is a placeholder. Provide your own database."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "reads_001",
      "type": "input_fastq",
      "position": [
        80,
        80
      ],
      "params": {
        "sample_name": "sample1",
        "reads": [
          "examples/data/metagenomics/reads_forward.fastq",
          "examples/data/metagenomics/reads_reverse.fastq"
        ]
      },
      "ui": {
        "title": "Input FASTQ",
        "validation": {
          "outputs": {
            "reads": {
              "expected_format": "fastq",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
