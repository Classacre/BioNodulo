        "cases": "spades,megahit",
        "num_branches": 2,
        "fallback": "error"
      },
      "ui": {
        "title": "Select Assembler"
      }
    },
    {
      "id": "spades_retry_001",
      "type": "retry",
      "position": [
        1160,
        362
      ],
      "params": {
        "max_retries": 2,
        "delay_seconds": 5.0,
        "backoff_multiplier": 2.0,
        "max_delay": 120,
        "retry_on": "all",
        "only_retry_specific_nodes": "spades_001"
      },
      "ui": {
        "title": "Retry SPAdes"
      }
    },
    {
      "id": "megahit_001",
      "type": "megahit",
