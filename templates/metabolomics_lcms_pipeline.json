{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Metabolomics LC-MS Workflow",
  "description": "Multi-sample LC-MS metabolomics workflow with explicit raw-file dependencies, XCMS centWave detection and obiwarp alignment, and CAMERA isotope/adduct annotation.",
  "category": "Metabolomics",
  "tags": [
    "metabolomics",
    "lc-ms",
    "xcms",
    "camera",
    "peak-detection",
    "retention-time",
    "annotation"
  ],
  "tools": [
    "input_file",
    "xcms_peak_detection",
    "xcms_retention_correction",
    "camera_annotation"
  ],
  "nodes": [
    {
      "id": "note_metabolomics_pipeline",
      "type": "note",
      "position": [
        -300,
        80
      ],
      "params": {
        "text": "Metabolomics raw-data example: detect chromatographic peaks with XCMS centWave, align retention times and fill peaks with obiwarp, then annotate isotope/adduct groups with CAMERA. The same ordered raw files feed all three analysis stages.\n\nDefaults are two real CE-MS runs from Bioconductor msdata 0.52.0: CEMS_10ppm.mzML and CEMS_25ppm.mzML, each containing 982 spectra. These acquisition fixtures demonstrate the tools; they are not a biological comparison cohort. For a study, supply matched runs in consistent edge order and one sample_groups value per file."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "mzml_001",
      "type": "input_file",
      "position": [
        80,
        182
      ],
      "params": {
        "file": "examples/data/metabolomics/sample.mzML"
      },
      "ui": {
        "title": "LC-MS Sample A",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "mzml_002",
      "type": "input_file",
      "position": [
        80,
        370
      ],
      "params": {
        "file": "examples/data/metabolomics/sample_2.mzML"
      },
      "ui": {
        "title": "LC-MS Sample B",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "xcms_peak_detection_001",
      "type": "xcms_peak_detection",
      "position": [
        440,
        191
      ],
      "params": {
        "ppm": 25.0,
        "peakwidth_min": 8.0,
        "peakwidth_max": 35.0,
        "snthresh": 10.0,
        "prefilter_k": 3,
        "prefilter_i": 100.0,
        "noise": 0.0,
        "threads": 4,
        "output_name": "lcms"
      },
      "ui": {
        "title": "XCMS Peak Detection",
        "validation": {
          "outputs": {
            "chrom_peaks": {
              "expected_format": "tsv",
              "min_size_bytes": 1,
              "min_records": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "xcms_retention_correction_001",
      "type": "xcms_retention_correction",
      "position": [
        800,
        212
      ],
      "params": {
        "method": "obiwarp",
        "bin_size": 1.0,
        "min_fraction": 0.5,
        "sample_groups": [
          "example",
          "example"
        ],
        "threads": 4,
        "output_name": "lcms_aligned"
      },
      "ui": {
        "title": "XCMS Retention Correction",
        "validation": {
          "outputs": {
            "aligned_feature_table": {
              "expected_format": "tsv",
              "min_size_bytes": 1,
              "min_records": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "camera_annotation_001",
      "type": "camera_annotation",
      "position": [
        1160,
        80
      ],
      "params": {
        "polarity": "positive",
        "run_group_corr": true,
        "correlation_include_isotopes": false,
        "run_adducts": true,
        "output_name": "lcms_camera"
      },
      "ui": {
        "title": "CAMERA Annotation",
        "validation": {
          "outputs": {
            "annotated_peaklist": {
              "expected_format": "tsv",
              "min_size_bytes": 1,
              "min_records": 1,
              "fail_on_error": true
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "mzml_001",
        "output": "file"
      },
      "to": {
        "node": "xcms_peak_detection_001",
        "input": "mzml_files"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "mzml_002",
        "output": "file"
      },
      "to": {
        "node": "xcms_peak_detection_001",
        "input": "mzml_files"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "xcms_peak_detection_001",
        "output": "xcms_object"
      },
      "to": {
        "node": "xcms_retention_correction_001",
        "input": "xcms_object"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "mzml_001",
        "output": "file"
      },
      "to": {
        "node": "xcms_retention_correction_001",
        "input": "raw_files"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "mzml_002",
        "output": "file"
      },
      "to": {
        "node": "xcms_retention_correction_001",
        "input": "raw_files"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "xcms_retention_correction_001",
        "output": "aligned_xcms_object"
      },
      "to": {
        "node": "camera_annotation_001",
        "input": "xcms_object"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "mzml_001",
        "output": "file"
      },
      "to": {
        "node": "camera_annotation_001",
        "input": "raw_files"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "mzml_002",
        "output": "file"
      },
      "to": {
        "node": "camera_annotation_001",
        "input": "raw_files"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "validated_mzml_a": "mzml_001",
    "validated_mzml_b": "mzml_002",
    "detected_chrom_peaks": "xcms_peak_detection_001",
    "aligned_features": "xcms_retention_correction_001",
    "camera_peaklist": "camera_annotation_001"
  }
}
