{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Metabolomics LC-MS Workflow",
  "description": "LC-MS metabolomics workflow that validates mzML input, detects chromatographic peaks with XCMS, performs retention-time correction, annotates peak groups with CAMERA, validates exported tables, and assembles an HTML report.",
  "category": "Metabolomics",
  "tags": [
    "metabolomics",
    "lc-ms",
    "xcms",
    "camera",
    "peak-detection",
    "retention-time",
    "annotation"
  ],
  "tools": [
    "input_file",
    "data_validator",
    "xcms_peak_detection",
    "xcms_retention_correction",
    "camera_annotation",
    "html_report",
    "html_preview"
  ],
  "nodes": [
    {
      "id": "note_metabolomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Metabolomics LC-MS workflow: validate mzML input, detect chromatographic peaks with XCMS centWave, align features with XCMS retention-time correction, annotate isotope/adduct groups with CAMERA, then collect aligned features and annotations into an HTML report.\n\nInputs are placeholders. Replace the mzML file with local centroided LC-MS data before execution and tune ppm/peak width parameters for the instrument method."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "mzml_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/metabolomics/sample.mzML"
      },
      "ui": {
        "title": "mzML Input"
      }
    },
    {
      "id": "validate_mzml_001",
      "type": "data_validator",
      "position": [
        440,
        80
      ],
      "params": {
        "expected_format": "auto",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate mzML"
      }
    },
    {
      "id": "xcms_peak_detection_001",
      "type": "xcms_peak_detection",
      "position": [
        800,
        80
      ],
      "params": {
        "ppm": 25.0,
        "peakwidth_min": 8.0,
        "peakwidth_max": 35.0,
        "snthresh": 10.0,
        "prefilter_k": 3,
        "prefilter_i": 100.0,
        "noise": 0.0,
        "threads": 4,
        "output_name": "lcms"
      },
      "ui": {
        "title": "XCMS Peak Detection"
      }
    },
    {
      "id": "validate_feature_table_001",
      "type": "data_validator",
      "position": [
        1160,
        80
      ],
      "params": {
        "expected_format": "tsv",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate Feature Table"
      }
    },
    {
      "id": "xcms_retention_correction_001",
      "type": "xcms_retention_correction",
      "position": [
        1160,
        546
      ],
      "params": {
        "method": "obiwarp",
        "bin_size": 1.0,
        "min_fraction": 0.5,
        "threads": 4,
        "output_name": "lcms_aligned"
      },
      "ui": {
        "title": "XCMS Retention Correction"
      }
    },
    {
      "id": "validate_aligned_features_001",
      "type": "data_validator",
      "position": [
        1520,
        80
      ],
      "params": {
        "expected_format": "tsv",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate Aligned Features"
      }
    },
    {
      "id": "camera_annotation_001",
      "type": "camera_annotation",
      "position": [
        1520,
        546
      ],
      "params": {
        "polarity": "positive",
        "run_group_corr": true,
        "run_adducts": true,
        "output_name": "lcms_camera"
      },
      "ui": {
        "title": "CAMERA Annotation"
      }
    },
    {
      "id": "validate_camera_peaklist_001",
      "type": "data_validator",
      "position": [
        1880,
        80
      ],
      "params": {
        "expected_format": "tsv",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate CAMERA Peaklist"
      }
    },
    {
      "id": "metabolomics_report_001",
      "type": "html_report",
      "position": [
        80,
        231
      ],
      "params": {
        "title": "Metabolomics LC-MS Report",
        "text_sections": "# Summary\nXCMS detects chromatographic peaks and performs retention-time correction for LC-MS metabolomics data. CAMERA annotates isotope, adduct, and pseudospectra relationships from the aligned XCMS object. The report links to the aligned feature table and CAMERA peak annotations generated by the workflow.",
        "tables": "xcms_retention_correction/lcms_aligned.aligned_feature_table.tsv,camera_annotation/lcms_camera.camera_peaklist.tsv",
        "section_names": "Aligned feature table,CAMERA peak annotations",
        "theme": "light",
        "include_toc": true,
        "max_table_rows": 100
      },
      "ui": {
        "title": "Metabolomics Report"
      }
    },
    {
      "id": "metabolomics_report_preview_001",
      "type": "html_preview",
      "position": [
        440,
        546
      ],
      "params": {},
      "ui": {
        "title": "View Metabolomics Report"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "mzml_001",
        "output": "file"
      },
      "to": {
        "node": "validate_mzml_001",
        "input": "input"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "validate_mzml_001",
        "output": "passthrough"
      },
      "to": {
        "node": "xcms_peak_detection_001",
        "input": "mzml_files"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "xcms_peak_detection_001",
        "output": "feature_table"
      },
      "to": {
        "node": "validate_feature_table_001",
        "input": "input"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "xcms_peak_detection_001",
        "output": "xcms_object"
      },
      "to": {
        "node": "xcms_retention_correction_001",
        "input": "xcms_object"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "xcms_retention_correction_001",
        "output": "aligned_feature_table"
      },
      "to": {
        "node": "validate_aligned_features_001",
        "input": "input"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "xcms_retention_correction_001",
        "output": "aligned_xcms_object"
      },
      "to": {
        "node": "camera_annotation_001",
        "input": "xcms_object"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "camera_annotation_001",
        "output": "annotated_peaklist"
      },
      "to": {
        "node": "validate_camera_peaklist_001",
        "input": "input"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "metabolomics_report_001",
        "output": "html_report"
      },
      "to": {
        "node": "metabolomics_report_preview_001",
        "input": "file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "validated_mzml": "validate_mzml_001",
    "xcms_features": "validate_feature_table_001",
    "aligned_features": "validate_aligned_features_001",
    "camera_peaklist": "validate_camera_peaklist_001",
    "report": "metabolomics_report_001",
    "report_preview": "metabolomics_report_preview_001"
  }
}
