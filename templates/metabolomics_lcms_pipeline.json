{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Metabolomics LC-MS Workflow",
  "description": "LC-MS metabolomics workflow that validates mzML input, detects chromatographic peaks with XCMS, performs retention-time correction, annotates peak groups with CAMERA, validates exported tables, and assembles an HTML report.",
  "category": "Metabolomics",
  "tags": [
    "metabolomics",
    "lc-ms",
    "xcms",
    "camera",
    "peak-detection",
    "retention-time",
    "annotation"
  ],
  "tools": [
    "input_file",
    "xcms_peak_detection",
    "xcms_retention_correction",
    "camera_annotation"
  ],
  "nodes": [
    {
      "id": "note_metabolomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Metabolomics LC-MS workflow: validate mzML input, detect chromatographic peaks with XCMS centWave, align features with XCMS retention-time correction, annotate isotope/adduct groups with CAMERA, then collect aligned features and annotations into an HTML report.\n\nInputs are placeholders. Replace the mzML file with local centroided LC-MS data before execution and tune ppm/peak width parameters for the instrument method."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "mzml_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/metabolomics/sample.mzML"
      },
      "ui": {
        "title": "mzML Input",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "xcms_peak_detection_001",
      "type": "xcms_peak_detection",
      "position": [
        440,
        80
      ],
      "params": {
        "ppm": 25.0,
        "peakwidth_min": 8.0,
        "peakwidth_max": 35.0,
        "snthresh": 10.0,
        "prefilter_k": 3,
        "prefilter_i": 100.0,
        "noise": 0.0,
        "threads": 4,
        "output_name": "lcms"
      },
      "ui": {
        "title": "XCMS Peak Detection",
        "validation": {
          "outputs": {
            "feature_table": {
              "expected_format": "tsv",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "xcms_retention_correction_001",
      "type": "xcms_retention_correction",
      "position": [
        800,
        80
      ],
      "params": {
        "method": "obiwarp",
        "bin_size": 1.0,
        "min_fraction": 0.5,
        "threads": 4,
        "output_name": "lcms_aligned"
      },
      "ui": {
        "title": "XCMS Retention Correction",
        "validation": {
          "outputs": {
            "aligned_feature_table": {
              "expected_format": "tsv",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "camera_annotation_001",
      "type": "camera_annotation",
      "position": [
        1160,
        80
      ],
      "params": {
        "polarity": "positive",
        "run_group_corr": true,
        "run_adducts": true,
        "output_name": "lcms_camera"
      },
      "ui": {
        "title": "CAMERA Annotation",
        "validation": {
          "outputs": {
            "annotated_peaklist": {
              "expected_format": "tsv",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e2",
      "from": {
        "node": "mzml_001",
        "output": "file"
      },
      "to": {
        "node": "xcms_peak_detection_001",
        "input": "mzml_files"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "xcms_peak_detection_001",
        "output": "xcms_object"
      },
      "to": {
        "node": "xcms_retention_correction_001",
        "input": "xcms_object"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "xcms_retention_correction_001",
        "output": "aligned_xcms_object"
      },
      "to": {
        "node": "camera_annotation_001",
        "input": "xcms_object"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "validated_mzml": "mzml_001",
    "xcms_features": "xcms_peak_detection_001",
    "aligned_features": "xcms_retention_correction_001",
    "camera_peaklist": "camera_annotation_001"
  }
}
