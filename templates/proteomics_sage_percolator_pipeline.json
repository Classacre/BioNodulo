{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Proteomics Sage-Percolator Search",
  "description": "Database-search DDA spectra with Sage, validate the Sage PIN output, estimate FDR with Percolator, and generate an HTML proteomics report.",
  "category": "Proteomics",
  "tags": [
    "proteomics",
    "dda",
    "sage",
    "percolator",
    "fdr",
    "peptide-identification"
  ],
  "tools": [
    "input_file",
    "input_fasta",
    "sage_search",
    "percolator"
  ],
  "nodes": [
    {
      "id": "note_proteomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Proteomics DDA search workflow: validate spectra and a target-decoy FASTA, run Sage with PIN output enabled, then stage Sage 0.14.7's full-digest PIN dialect for Percolator PSM and picked-protein FDR estimates. The staging step adds the flanking syntax required by Percolator protein inference and expands Sage's semicolon-joined protein identifiers.\n\nInputs are placeholders. Provide mzML, gzipped mzML, or MGF spectra and a target-decoy protein FASTA with DECOY_-prefixed decoy accessions before execution."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "spectra_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/proteomics/sample.mzML"
      },
      "ui": {
        "title": "Spectra File",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "fasta_001",
      "type": "input_fasta",
      "position": [
        80,
        231
      ],
      "params": {
        "reference": "examples/data/proteomics/target_decoy.fasta"
      },
      "ui": {
        "title": "Protein FASTA",
        "validation": {
          "outputs": {
            "reference": {
              "expected_format": "fasta",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "sage_search_001",
      "type": "sage_search",
      "position": [
        440,
        80
      ],
      "params": {
        "batch_size": 1,
        "precursor_tol_ppm": 20.0,
        "fragment_tol_da": 0.05,
        "missed_cleavages": 2,
        "min_peptide_length": 7,
        "max_peptide_length": 40,
        "decoy_tag": "rev_",
        "generate_decoys": true
      },
      "ui": {
        "title": "Sage Search",
        "validation": {
          "outputs": {
            "pin_file": {
              "expected_format": "text",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "percolator_001",
      "type": "percolator",
      "position": [
        800,
        80
      ],
      "params": {
        "pin_dialect": "sage_0_14_7_full_digest",
        "search_input": "concatenated",
        "decoy_prefix": "rev_",
        "test_fdr": 0.01,
        "train_fdr": 0.01,
        "protein_enzyme": "trypsin"
      },
      "ui": {
        "title": "Percolator FDR",
        "validation": {
          "outputs": {
            "percolator_psms": {
              "expected_format": "tsv",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "render_percolator_tab_0",
      "type": "table_preview",
      "position": [
        1520,
        80
      ],
      "params": {},
      "ui": {
        "title": "View Table: percolator"
      }
    },
    {
      "id": "render_percolator_tab_1",
      "type": "table_preview",
      "position": [
        1520,
        300
      ],
      "params": {},
      "ui": {
        "title": "View Table: percolator"
      }
    },
    {
      "id": "render_sage_search_tab_2",
      "type": "table_preview",
      "position": [
        1520,
        520
      ],
      "params": {},
      "ui": {
        "title": "View Table: sage_search"
      }
    }
  ],
  "edges": [
    {
      "id": "e3",
      "from": {
        "node": "spectra_001",
        "output": "file"
      },
      "to": {
        "node": "sage_search_001",
        "input": "spectra_files"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "fasta_001",
        "output": "reference"
      },
      "to": {
        "node": "sage_search_001",
        "input": "fasta_db"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "sage_search_001",
        "output": "pin_file"
      },
      "to": {
        "node": "percolator_001",
        "input": "pin_file"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "fasta_001",
        "output": "reference"
      },
      "to": {
        "node": "percolator_001",
        "input": "fasta_db"
      }
    },
    {
      "from": {
        "node": "percolator_001",
        "output": "percolator_psms"
      },
      "to": {
        "node": "render_percolator_tab_0",
        "input": "file"
      },
      "id": "e8"
    },
    {
      "from": {
        "node": "percolator_001",
        "output": "percolator_proteins"
      },
      "to": {
        "node": "render_percolator_tab_1",
        "input": "file"
      },
      "id": "e9"
    },
    {
      "from": {
        "node": "sage_search_001",
        "output": "results_tsv"
      },
      "to": {
        "node": "render_sage_search_tab_2",
        "input": "file"
      },
      "id": "e10"
    }
  ],
  "groups": [],
  "outputs": {
    "validated_spectra": "spectra_001",
    "validated_fasta": "fasta_001",
    "sage_results": "sage_search_001",
    "sage_pin": "sage_search_001",
    "validated_sage_pin": "sage_search_001",
    "percolator_psms": "percolator_001",
    "percolator_proteins": "percolator_001"
  }
}
