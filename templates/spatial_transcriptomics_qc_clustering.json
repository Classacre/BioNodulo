{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Spatial Transcriptomics QC and Clustering",
  "description": "Spatial transcriptomics workflow for precomputed 10x Genomics Visium outputs. It validates a Space Ranger outs directory, runs Squidpy QC and spatial visualization, optionally clusters a small count matrix with Scanpy, previews generated plots, and assembles an HTML QC report.",
  "category": "Spatial Transcriptomics",
  "tags": [
    "spatial-transcriptomics",
    "visium",
    "spaceranger",
    "squidpy",
    "scanpy",
    "qc",
    "clustering",
    "umap"
  ],
  "tools": [
    "input_directory",
    "input_file",
    "data_validator",
    "squidpy_qc",
    "scanpy_spatial",
    "image_preview",
    "html_report",
    "html_preview"
  ],
  "nodes": [
    {
      "id": "note_spatial_transcriptomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Spatial transcriptomics QC and clustering workflow: validate a precomputed Space Ranger outs directory, run Squidpy QC and spatial visualization, run Scanpy clustering on a small count matrix plus spot coordinates, preview generated images, and compile the QC outputs into an HTML report.\n\nInputs are placeholders. Use a Space Ranger outs directory for Squidpy. The optional Scanpy branch expects a gene-by-spot CSV count matrix and a coordinates CSV containing a barcode column."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
