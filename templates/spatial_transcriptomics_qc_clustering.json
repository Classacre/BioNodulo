{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Spatial Transcriptomics QC and Clustering",
  "description": "Spatial transcriptomics workflow for precomputed 10x Genomics Visium outputs. It validates a Space Ranger outs directory, runs Squidpy QC and spatial visualization, optionally clusters a small count matrix with Scanpy, previews generated plots, and assembles an HTML QC report.",
  "category": "Spatial Transcriptomics",
  "tags": [
    "spatial-transcriptomics",
    "visium",
    "spaceranger",
    "squidpy",
    "scanpy",
    "qc",
    "clustering",
    "umap"
  ],
  "tools": [
    "input_directory",
    "input_file",
    "squidpy_qc",
    "scanpy_spatial",
    "image_preview"
  ],
  "nodes": [
    {
      "id": "note_spatial_transcriptomics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Spatial transcriptomics QC and clustering workflow: validate a precomputed Space Ranger outs directory, run Squidpy QC and spatial visualization, run Scanpy clustering on a small count matrix plus spot coordinates, preview generated images, and compile the QC outputs into an HTML report.\n\nInputs are placeholders. Use a Space Ranger outs directory for Squidpy. The optional Scanpy branch expects a gene-by-spot CSV count matrix and a coordinates CSV containing a barcode column."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "visium_outs_001",
      "type": "input_directory",
      "position": [
        80,
        80
      ],
      "params": {
        "directory": "examples/data/spatial_transcriptomics/visium_outs"
      },
      "ui": {
        "title": "Visium outs Directory",
        "validation": {
          "outputs": {
            "directory": {
              "expected_format": "directory",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "squidpy_qc_001",
      "type": "squidpy_qc",
      "position": [
        440,
        80
      ],
      "params": {
        "min_counts": 500,
        "min_cells": 3,
        "max_mt_pct": 20.0,
        "n_hvg": 2000,
        "n_pcs": 15,
        "resolution": 0.8
      },
      "ui": {
        "title": "Squidpy QC",
        "validation": {
          "outputs": {
            "adata": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "spatial_plot_preview_001",
      "type": "image_preview",
      "position": [
        800,
        80
      ],
      "params": {},
      "ui": {
        "title": "Preview Spatial Plot"
      }
    },
    {
      "id": "scanpy_spatial_001",
      "type": "scanpy_spatial",
      "position": [
        440,
        500
      ],
      "params": {
        "sample_name": "visium_sample",
        "min_cells": 3,
        "min_genes": 200,
        "n_hvg": 2000,
        "n_pcs": 15,
        "resolution": 0.8
      },
      "ui": {
        "title": "Scanpy Spatial",
        "validation": {
          "outputs": {
            "clusters": {
              "expected_format": "csv",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "scanpy_umap_preview_001",
      "type": "image_preview",
      "position": [
        800,
        354
      ],
      "params": {},
      "ui": {
        "title": "Preview Scanpy UMAP"
      }
    }
  ],
  "edges": [
    {
      "id": "e2",
      "from": {
        "node": "visium_outs_001",
        "output": "directory"
      },
      "to": {
        "node": "squidpy_qc_001",
        "input": "visium_path"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "squidpy_qc_001",
        "output": "spatial_plot"
      },
      "to": {
        "node": "spatial_plot_preview_001",
        "input": "file"
      }
    },
    {
      "id": "e10",
      "from": {
        "node": "scanpy_spatial_001",
        "output": "umap"
      },
      "to": {
        "node": "scanpy_umap_preview_001",
        "input": "file"
      }
    },
    {
      "from": {
        "node": "squidpy_qc_001",
        "output": "adata"
      },
      "to": {
        "node": "scanpy_spatial_001",
        "input": "adata"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "validated_visium_outs": "visium_outs_001",
    "squidpy_adata": "squidpy_qc_001",
    "spatial_plot_preview": "spatial_plot_preview_001",
    "scanpy_clusters": "scanpy_spatial_001",
    "scanpy_umap_preview": "scanpy_umap_preview_001"
  }
}
