{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Spatial Transcriptomics QC and Clustering",
  "description": "Spatial transcriptomics workflow for precomputed 10x Genomics Visium outputs. It validates a Space Ranger outs directory, runs Squidpy QC and spatial visualization, passes the resulting H5AD artifact into Scanpy clustering, and previews the generated plots.",
  "category": "Spatial Transcriptomics",
  "tags": [
    "spatial-transcriptomics",
    "visium",
    "spaceranger",
    "squidpy",
    "scanpy",
    "qc",
    "clustering",
    "umap"
  ],
  "tools": [
    "input_directory",
    "input_file",
    "squidpy_qc",
    "scanpy_spatial",
    "image_preview"
  ],
  "nodes": [
    {
      "id": "note_spatial_transcriptomics_pipeline",
      "type": "note",
      "position": [
        -300,
        80
      ],
      "params": {
        "text": "Spatial transcriptomics example: load a complete Space Ranger-style outs directory, run Squidpy QC/spatial visualization, cluster with Scanpy, and preview the resulting images.\n\nDefaults materialize the nf-core spatialvi human brain cancer Visium test example, including the feature matrix, tissue positions, scalefactors, and both hires and lowres tissue images. Its nonzero raw matrix is staged under the conventional filtered-matrix filename expected by readers. The data are downsampled and use permissive demonstration QC thresholds; choose suitable thresholds for a study."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "visium_outs_001",
      "type": "input_directory",
      "position": [
        80,
        216
      ],
      "params": {
        "directory": "examples/data/spatial_transcriptomics/visium_outs"
      },
      "ui": {
        "title": "Visium outs Directory",
        "validation": {
          "outputs": {
            "directory": {
              "expected_format": "directory",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "squidpy_qc_001",
      "type": "squidpy_qc",
      "position": [
        440,
        128
      ],
      "params": {
        "min_counts": 3,
        "min_cells": 1,
        "max_mt_pct": 100.0,
        "n_hvg": 500,
        "n_pcs": 10,
        "resolution": 0.8
      },
      "ui": {
        "title": "Squidpy QC",
        "validation": {
          "outputs": {
            "adata": {
              "expected_format": "auto",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "spatial_plot_preview_001",
      "type": "image_preview",
      "position": [
        800,
        80
      ],
      "params": {},
      "ui": {
        "title": "Preview Spatial Plot"
      }
    },
    {
      "id": "scanpy_spatial_001",
      "type": "scanpy_spatial",
      "position": [
        800,
        198
      ],
      "params": {
        "sample_name": "visium_sample",
        "min_cells": 1,
        "min_genes": 3,
        "n_hvg": 500,
        "n_pcs": 10,
        "resolution": 0.8
      },
      "ui": {
        "title": "Scanpy Spatial",
        "validation": {
          "outputs": {
            "clusters": {
              "expected_format": "csv",
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "scanpy_umap_preview_001",
      "type": "image_preview",
      "position": [
        1160,
        216
      ],
      "params": {},
      "ui": {
        "title": "Preview Scanpy UMAP"
      }
    }
  ],
  "edges": [
    {
      "id": "e2",
      "from": {
        "node": "visium_outs_001",
        "output": "directory"
      },
      "to": {
        "node": "squidpy_qc_001",
        "input": "visium_path"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "squidpy_qc_001",
        "output": "spatial_plot"
      },
      "to": {
        "node": "spatial_plot_preview_001",
        "input": "file"
      }
    },
    {
      "id": "e10",
      "from": {
        "node": "scanpy_spatial_001",
        "output": "umap"
      },
      "to": {
        "node": "scanpy_umap_preview_001",
        "input": "file"
      }
    },
    {
      "from": {
        "node": "squidpy_qc_001",
        "output": "adata"
      },
      "to": {
        "node": "scanpy_spatial_001",
        "input": "adata"
      },
      "id": "e11"
    }
  ],
  "groups": [],
  "outputs": {
    "validated_visium_outs": "visium_outs_001",
    "squidpy_adata": "squidpy_qc_001",
    "spatial_plot_preview": "spatial_plot_preview_001",
    "scanpy_clusters": "scanpy_spatial_001",
    "scanpy_umap_preview": "scanpy_umap_preview_001"
  }
}
