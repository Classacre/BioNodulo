    {
      "id": "note_crispr_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "CRISPR workflow: validate genome, amplicon FASTQ, pooled-screen FASTQ, and sgRNA library inputs; design guides from a target interval; run Cas-OFFinder for candidate off-targets; quantify amplicon editing with CRISPResso2; count and rank pooled-screen sgRNAs with MAGeCK; then collect the core outputs into an HTML report.\n\nInputs are placeholders. Set the genome FASTA, edited amplicon FASTQs, pooled-screen FASTQs, and sgRNA library before execution. Edit guide_seq and amplicon_seq on the CRISPResso2/Cas-OFFinder nodes for the target locus."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "genome_001",
      "type": "input_fasta",
      "position": [
        80,
        80
      ],
      "params": {
        "reference": "examples/data/crispr/genome.fa"
      },
      "ui": {
        "title": "Genome FASTA"
      }
    },
    {
      "id": "guide_design_001",
      "type": "guide_rna_design",
      "position": [
        800,
        80
      ],
      "params": {
        "target": "chr1:1-1000",
        "pam": "NGG",
        "guide_length": 20,
        "max_guides": 50,
        "mismatches": 3
      },
      "ui": {
        "title": "Guide RNA Design"
      }
    },
    {
      "id": "cas_offinder_001",
