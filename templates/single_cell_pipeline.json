{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Single Cell RNA-Seq",
  "description": "10x Genomics single cell RNA sequencing analysis with Cell Ranger",
  "nodes": [
    {
      "id": "note_single_cell_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Single-cell pipeline: processes 10x Genomics data with Cell Ranger for count matrices.\n\nData source: 10x Genomics cellranger-tiny-fastq test dataset (via GitHub/minoda-lab/universc).\nSample: tinygex (2 lanes: L001 + L002, I1/R1/R2 reads).\nURL: https://github.com/minoda-lab/universc/tree/master/test/shared/cellranger-tiny-fastq\nNote: Cell Ranger reference directory is a placeholder. Provide your own reference (e.g. refdata-gex-GRCh38 from 10x Genomics)."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "fastq_001",
      "type": "input_directory",
      "position": [
        80,
        80
      ],
      "params": {
        "directory": "examples/data/single_cell"
      },
      "ui": {
        "title": "FASTQ Directory"
      }
    },
    {
      "id": "ref_001",
      "type": "input_directory",
      "position": [
        80,
        234
      ],
      "params": {
        "directory": "refdata-gex-GRCh38"
      },
      "ui": {
        "title": "Cell Ranger Reference"
      }
    },
    {
      "id": "cr_count_001",
      "type": "cellranger_count",
      "position": [
        440,
        80
      ],
      "params": {
        "sample": "tinygex",
        "expect_cells": 100
      },
      "ui": {
        "title": "Cell Ranger Count"
      }
    },
    {
      "id": "validate_fastq_dir_001",
      "type": "data_validator",
      "position": [
        260,
        80
      ],
      "params": {
        "expected_format": "directory",
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate FASTQ Directory"
      }
    },
    {
      "id": "validate_reference_dir_001",
      "type": "data_validator",
      "position": [
        260,
