        "input": "sequences"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "mafft_001",
        "output": "alignment"
      },
      "to": {
        "node": "iqtree_001",
        "input": "alignment"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "tree": "iqtree_001",
    "alignment": "mafft_001"
  }
