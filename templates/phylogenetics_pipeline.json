{
  "version": "2.0",
  "app": "bionodulo",
  "name": "Phylogenetics Pipeline",
  "description": "Multiple sequence alignment and phylogenetic tree construction",
  "nodes": [
    {
      "id": "note_phylogenetics_pipeline",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "Phylogenetics pipeline: aligns sequences with MAFFT and builds trees with IQ-TREE.\n\nData source: NCBI RefSeq 16S ribosomal RNA sequences fetched via E-utilities (https://eutils.ncbi.nlm.nih.gov/).\nSequences:\n- NR_024570.1 Escherichia coli\n- NR_027552.1 Bacillus subtilis\n- NR_036781.1 Staphylococcus aureus\n- NR_026078.1 Pseudomonas aeruginosa\n- NR_028747.1 Salmonella enterica\nFile: 16s_sequences.fasta (~8 KB, 5 sequences)."
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "ncbi_efetch_001",
      "type": "ncbi_efetch",
      "position": [
        80,
        231
      ],
      "params": {
        "id_list": "NR_024570.1,NR_027552.1,NR_036781.1,NR_026078.1,NR_028747.1",
        "database": "nuccore",
        "rettype": "fasta",
        "retmode": "text",
        "output_name": "16s_sequences.fasta"
      },
      "ui": {
        "title": "Fetch NCBI 16S"
      }
    },
    {
      "id": "mafft_001",
      "type": "mafft",
      "position": [
        800,
        80
      ],
      "params": {
        "threads": 4,
        "strategy": "auto"
      },
      "ui": {
        "title": "MAFFT Alignment"
      }
    },
    {
      "id": "validate_fasta_001",
      "type": "data_validator",
      "position": [
        440,
        80
      ],
      "params": {
        "expected_format": "fasta",
        "min_records": 3,
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate FASTA"
      }
    },
    {
      "id": "gate_fasta_001",
      "type": "gate",
      "position": [
        800,
        246
      ],
      "params": {
        "condition_mode": "boolean_is_true",
        "on_fail": "halt",
        "error_message": "FASTA validation failed before phylogenetic alignment"
      },
      "ui": {
        "title": "Gate Valid FASTA"
      }
    },
    {
      "id": "iqtree_001",
      "type": "iqtree",
      "position": [
        1160,
        80
      ],
      "params": {
        "threads": 4,
        "model": "MFP",
        "ufboot_replicates": 1000,
        "alrt_replicates": 1000
      },
      "ui": {
        "title": "IQ-TREE"
      }
    },
    {
      "id": "msa_view_001",
      "type": "bp_msa_view",
      "position": [
        1160,
        261
      ],
      "params": {
        "format": "fasta"
      },
      "ui": {
        "title": "MSA View"
      }
    },
    {
      "id": "image_preview_001",
      "type": "image_preview",
      "position": [
        1520,
        80
      ],
      "params": {},
      "ui": {
        "title": "View Alignment"
      }
    },
    {
      "id": "tree_viewer_001",
      "type": "phylo_tree_viewer",
      "position": [
        1520,
        354
      ],
      "params": {
        "layout": "rectangular",
        "show_bootstrap": true,
        "bootstrap_threshold": 70,
        "title": "16S Phylogenetic Tree",
        "format": "png"
      },
      "ui": {
        "title": "Render Tree"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "ncbi_efetch_001",
        "output": "records"
      },
      "to": {
        "node": "validate_fasta_001",
        "input": "input"
      }
    },
    {
      "id": "e1b",
      "from": {
        "node": "validate_fasta_001",
        "output": "passthrough"
      },
      "to": {
        "node": "mafft_001",
        "input": "input"
      }
    },
    {
      "id": "e1c",
      "from": {
        "node": "validate_fasta_001",
        "output": "passed"
      },
      "to": {
        "node": "gate_fasta_001",
        "input": "value"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "mafft_001",
        "output": "alignment"
      },
      "to": {
        "node": "iqtree_001",
        "input": "alignment"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "mafft_001",
        "output": "alignment"
      },
      "to": {
        "node": "msa_view_001",
        "input": "alignment_file"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "msa_view_001",
        "output": "alignment_image"
      },
      "to": {
        "node": "image_preview_001",
        "input": "file"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "iqtree_001",
        "output": "tree"
      },
      "to": {
        "node": "tree_viewer_001",
        "input": "tree_file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "tree": "iqtree_001",
    "tree_image": "tree_viewer_001",
    "alignment": "mafft_001",
    "fetched_fasta": "ncbi_efetch_001",
    "validated_fasta": "validate_fasta_001",
    "fasta_quality_gate": "gate_fasta_001"
  }
}
