{
  "version": "Alpha 1.2",
  "app": "bionodulo",
  "name": "RNA-Seq Pipeline",
  "description": "Complete RNA sequencing analysis from reads to counts",
  "nodes": [
    {
      "id": "note_rna_seq_pipeline",
      "type": "note",
      "position": [
        -240,
        220
      ],
      "params": {
        "text": "RNA-Seq pipeline: aligns reads with HISAT2, sorts BAM, and counts features with featureCounts.\nData: S. cerevisiae RNA-seq reads SRR6357070 (subsampled) from nf-core/test-datasets GSE110004. Reference genome + GFF from NCBI RefSeq GCF_000146045.2 (R64).\nSources: https://github.com/nf-core/test-datasets | https://www.ncbi.nlm.nih.gov/datasets/genome/GCF_000146045.2/"
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "reads_001",
      "type": "input_fastq",
      "position": [
        80,
        60
      ],
      "params": {
        "sample_name": "sample1",
        "paired_end": true,
        "reads": [
          "examples/data/rna_seq/SRR6357070_1.fastq",
          "examples/data/rna_seq/SRR6357070_2.fastq"
        ]
      },
      "ui": {
        "title": "Input FASTQ"
      }
    },
    {
      "id": "ref_001",
      "type": "input_fasta",
      "position": [
        80,
        220
      ],
      "params": {
        "file_path": "examples/data/rna_seq/genome.fa"
      },
      "ui": {
        "title": "Reference FASTA"
      }
    },
    {
      "id": "hisat2_build_001",
      "type": "hisat2_build",
      "position": [
        340,
        220
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "HISAT2 Build"
      }
    },
    {
      "id": "fastp_001",
      "type": "fastp",
      "position": [
        340,
        60
      ],
      "params": {
        "threads": 4,
        "adapter_sequence": "auto"
      },
      "ui": {
        "title": "fastp Trim"
      }
    },
    {
      "id": "hisat2_001",
      "type": "hisat2_align",
      "position": [
        600,
        60
      ],
      "params": {
        "threads": 8
      },
      "ui": {
        "title": "HISAT2 Align"
      }
    },
    {
      "id": "sort_001",
      "type": "samtools_sort",
      "position": [
        860,
        60
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "samtools sort"
      }
    },
    {
      "id": "annot_001",
      "type": "input_gff",
      "position": [
        600,
        280
      ],
      "params": {
        "file_path": "examples/data/rna_seq/annotation.gff"
      },
      "ui": {
        "title": "Annotation GFF"
      }
    },
    {
      "id": "counts_001",
      "type": "featurecounts",
      "position": [
        1120,
        60
      ],
      "params": {
        "feature_type": "gene",
        "attribute": "gene_id"
      },
      "ui": {
        "title": "featureCounts"
      }
    },
    {
      "id": "qc_001",
      "type": "fastqc",
      "position": [
        340,
        380
      ],
      "params": {
        "threads": 4
      },
      "ui": {
        "title": "FastQC"
      }
    },
    {
      "id": "mqc_001",
      "type": "multiqc",
      "position": [
        860,
        380
      ],
      "params": {
        "title": "RNA-Seq QC"
      },
      "ui": {
        "title": "MultiQC"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "reads_001",
        "output": "reads"
      },
      "to": {
        "node": "fastp_001",
        "input": "reads"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "fastp_001",
        "output": "trimmed_reads"
      },
      "to": {
        "node": "hisat2_001",
        "input": "reads"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "ref_001",
        "output": "reference"
      },
      "to": {
        "node": "hisat2_build_001",
        "input": "reference"
      }
    },
    {
      "id": "e3b",
      "from": {
        "node": "hisat2_build_001",
        "output": "index"
      },
      "to": {
        "node": "hisat2_001",
        "input": "index"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "hisat2_001",
        "output": "alignment"
      },
      "to": {
        "node": "sort_001",
        "input": "input"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "sort_001",
        "output": "sorted_bam"
      },
      "to": {
        "node": "counts_001",
        "input": "bam"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "annot_001",
        "output": "annotations"
      },
      "to": {
        "node": "counts_001",
        "input": "annotation"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "reads_001",
        "output": "reads"
      },
      "to": {
        "node": "qc_001",
        "input": "reads"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "qc_001",
        "output": "report_dir"
      },
      "to": {
        "node": "mqc_001",
        "input": "reports"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "counts": "counts_001",
    "report": "mqc_001"
  }
}