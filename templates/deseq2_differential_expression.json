{
  "version": "2.0",
  "app": "bionodulo",
  "name": "DESeq2 Differential Expression",
  "description": "End-to-end differential expression analysis with DESeq2 and visualization",
  "nodes": [
    {
      "id": "note_deseq2",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "DESeq2 Differential Expression Pipeline\n\nDemonstrates BioNodulo's Bioconductor integration.\n\n1. Input: Count matrix (genes x samples) + sample metadata\n2. DESeq2: Normalization, dispersion estimation, Wald test\n3. Output: Results table, MA plot, normalized counts\n\nData: Simulated yeast RNA-seq count data (60 genes, 6 samples: 3 control + 3 treated).\nRequires: R + DESeq2 + ggplot2 + readr"
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "counts_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/biopython/deseq2_counts.csv"
      },
      "ui": {
        "title": "Count Matrix"
      }
    },
    {
      "id": "samples_001",
      "type": "input_file",
      "position": [
        80,
        234
      ],
      "params": {
        "file": "examples/data/biopython/deseq2_sample_info.csv"
      },
      "ui": {
        "title": "Sample Info"
      }
    },
    {
      "id": "validate_counts_001",
      "type": "data_validator",
      "position": [
        440,
        80
      ],
      "params": {
        "expected_format": "csv",
        "min_records": 1,
        "min_size_bytes": 1,
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate Count Matrix"
      }
    },
    {
      "id": "validate_samples_001",
      "type": "data_validator",
      "position": [
        440,
        234
      ],
      "params": {
        "expected_format": "csv",
        "min_records": 2,
        "min_size_bytes": 1,
        "required_fields": "sample,condition",
        "fail_on_error": true
      },
      "ui": {
        "title": "Validate Sample Info"
      }
    },
    {
      "id": "deseq2_001",
      "type": "deseq2_analysis",
      "position": [
        800,
        80
      ],
      "params": {
        "design_formula": "~ condition",
        "contrast": "condition,treated,control",
        "min_counts": 10,
        "lfc_threshold": 0.0,
        "padj_threshold": 0.05
      },
      "ui": {
        "title": "DESeq2 Analysis"
      }
    },
    {
      "id": "heatmap_001",
      "type": "r_pheatmap",
      "position": [
        1160,
        80
      ],
      "params": {
        "scale": "row",
        "annotation_csv": "examples/data/biopython/heatmap_annotation.csv",
        "cluster_rows": true,
        "cluster_cols": true,
        "show_rownames": true,
        "show_colnames": true,
        "fontsize": 10,
        "width": 900,
        "height": 700
      },
      "ui": {
        "title": "DE Heatmap"
      }
    },
    {
      "id": "volcano_001",
      "type": "volcano_plot",
      "position": [
        1160,
        320
      ],
      "params": {
        "title": "DESeq2 Volcano Plot",
        "format": "png",
        "logfc_column": "log2FoldChange",
        "pvalue_column": "padj"
      },
      "ui": {
        "title": "Volcano Plot"
      }
    },
    {
      "id": "ma_plot_001",
      "type": "ma_plot",
      "position": [
        1160,
        560
      ],
      "params": {
        "title": "DESeq2 MA Plot",
        "format": "png",
        "mean_column": "baseMean",
        "logfc_column": "log2FoldChange",
        "pvalue_column": "padj"
      },
      "ui": {
        "title": "MA Plot"
      }
    },
    {
      "id": "pca_plot_001",
      "type": "scatter_plot",
      "position": [
        1160,
        800
      ],
      "params": {
        "title": "DESeq2 PCA Plot",
        "x_column": "PC1",
        "y_column": "PC2",
        "color_column": "condition",
        "xlabel": "PC1",
        "ylabel": "PC2",
        "format": "png"
      },
      "ui": {
        "title": "PCA Plot"
      }
    },
    {
      "id": "significant_genes_001",
      "type": "filter_rows",
      "position": [
        1160,
        1040
      ],
      "params": {
        "column": "padj",
        "operator": "less_or_equal",
        "value": "0.05",
        "column_2": "log2FoldChange",
        "operator_2": "is_not_empty",
        "logical_op": "AND",
        "output_type": "CSV"
      },
      "ui": {
        "title": "Significant Genes"
      }
    },
    {
      "id": "pathway_gene_sets_001",
      "type": "input_file",
      "position": [
        1160,
        1280
      ],
      "params": {
        "file": "templates/data/deseq2_gene_sets.json"
      },
      "ui": {
        "title": "Example Gene Sets"
      }
    },
    {
      "id": "normalized_counts_transpose_001",
      "type": "transpose_table",
      "position": [
        1160,
        800
      ],
      "params": {
        "id_column": "gene",
        "new_header": "sample",
        "output_type": "CSV"
      },
      "ui": {
        "title": "Transpose Normalized Counts"
      }
    },
    {
      "id": "pathway_enrichment_001",
      "type": "intersect_genes",
      "position": [
        1520,
        1040
      ],
      "params": {
        "input_column": "gene",
        "database_format": "json",
        "case_sensitive": false
      },
      "ui": {
        "title": "Pathway Overlap"
      }
    },
    {
      "id": "string_enrichment_001",
      "type": "string_db",
      "position": [
        1520,
        1280
      ],
      "params": {
        "protein_ids": "",
        "protein_table": "",
        "id_column": "gene",
        "species": 4932,
        "query_type": "enrichment"
      },
      "ui": {
        "title": "STRING Enrichment"
      }
    },
    {
      "id": "de_report_001",
      "type": "html_report",
      "position": [
        1520,
        320
      ],
      "params": {
        "title": "DESeq2 Differential Expression Report",
        "text_sections": "# Summary\nDifferential expression results with volcano, MA, heatmap, full result table, filtered significant genes, transposed normalized counts for sample-oriented review, and pathway gene-set overlaps.",
        "section_names": "Volcano plot,MA plot,PCA plot,Expression heatmap,DESeq2 results,Normalized counts,Transposed normalized counts,Significant genes,Pathway overlaps,STRING enrichment"
      },
      "ui": {
        "title": "DE Report"
      }
    },
    {
