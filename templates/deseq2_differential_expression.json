{
  "version": "2.0",
  "app": "bionodulo",
  "name": "DESeq2 Differential Expression",
  "description": "End-to-end differential expression analysis with DESeq2 and visualization",
  "nodes": [
    {
      "id": "note_deseq2",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "DESeq2 Differential Expression Pipeline\n\nDemonstrates BioNodulo's Bioconductor integration.\n\n1. Input: Count matrix (genes x samples) + sample metadata\n2. DESeq2: Normalization, dispersion estimation, Wald test\n3. Output: Results table, MA plot, normalized counts\n\nData: Simulated yeast RNA-seq count data (60 genes, 6 samples: 3 control + 3 treated).\nRequires: R + DESeq2 + ggplot2 + readr"
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "counts_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/biopython/deseq2_counts.csv"
      },
      "ui": {
        "title": "Count Matrix",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "csv",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "samples_001",
      "type": "input_file",
      "position": [
        80,
        231
      ],
      "params": {
        "file": "examples/data/biopython/deseq2_sample_info.csv"
      },
      "ui": {
        "title": "Sample Info",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "csv",
              "min_records": 2,
              "min_size_bytes": 1,
              "required_fields": "sample,condition",
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "heatmap_annotation_001",
      "type": "input_file",
      "position": [
        80,
        533
      ],
      "params": {
        "file": "examples/data/biopython/heatmap_annotation.csv"
      },
      "ui": {
        "title": "Heatmap Annotation",
        "validation": {
          "outputs": {
            "file": {
              "expected_format": "csv",
              "min_records": 1,
              "min_size_bytes": 1,
              "fail_on_error": true
            }
          }
        }
      }
    },
    {
      "id": "deseq2_001",
      "type": "deseq2_analysis",
      "position": [
        440,
        80
      ],
      "params": {
        "design_formula": "~ condition",
        "contrast": "condition,treated,control",
        "min_counts": 10,
        "lfc_threshold": 0.0,
        "padj_threshold": 0.05
      },
      "ui": {
        "title": "DESeq2 Analysis"
      }
    },
    {
      "id": "heatmap_001",
      "type": "r_pheatmap",
      "position": [
        800,
        80
      ],
      "params": {
        "scale": "row",
        "cluster_rows": true,
        "cluster_cols": true,
        "show_rownames": true,
        "show_colnames": true,
        "fontsize": 10,
        "width": 900,
        "height": 700
      },
      "ui": {
        "title": "DE Heatmap"
      }
    },
    {
      "id": "volcano_001",
      "type": "volcano_plot",
      "position": [
        800,
        614
      ],
      "params": {
        "title": "DESeq2 Volcano Plot",
        "format": "html",
        "logfc_column": "log2FoldChange",
        "pvalue_column": "padj"
      },
      "ui": {
        "title": "Volcano Plot"
      }
    },
    {
      "id": "ma_plot_001",
      "type": "ma_plot",
      "position": [
        800,
        1448
      ],
      "params": {
        "title": "DESeq2 MA Plot",
        "format": "html",
        "mean_column": "baseMean",
        "logfc_column": "log2FoldChange",
        "pvalue_column": "padj"
      },
      "ui": {
        "title": "MA Plot"
      }
    },
    {
      "id": "pca_plot_001",
      "type": "scatter_plot",
      "position": [
        800,
        2282
      ],
      "params": {
        "title": "DESeq2 PCA Plot",
        "x_column": "PC1",
        "y_column": "PC2",
        "color_column": "condition",
        "xlabel": "PC1",
        "ylabel": "PC2",
        "format": "html"
      },
      "ui": {
        "title": "PCA Plot"
      }
    },
    {
      "id": "significant_genes_001",
      "type": "filter_rows",
      "position": [
        800,
        3490
      ],
      "params": {
        "column": "padj",
        "operator": "less_or_equal",
        "value": "0.05",
        "column_2": "log2FoldChange",
        "operator_2": "is_not_empty",
        "logical_op": "AND",
        "output_type": "CSV"
      },
      "ui": {
        "title": "Significant Genes"
      }
