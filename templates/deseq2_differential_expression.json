{
  "version": "2.0",
  "app": "bionodulo",
  "name": "DESeq2 Differential Expression",
  "description": "End-to-end differential expression analysis with DESeq2 and visualization",
  "nodes": [
    {
      "id": "note_deseq2",
      "type": "note",
      "position": [
        -240,
        80
      ],
      "params": {
        "text": "DESeq2 Differential Expression Pipeline\n\nDemonstrates BioNodulo's Bioconductor integration.\n\n1. Input: Count matrix (genes x samples) + sample metadata\n2. DESeq2: Normalization, dispersion estimation, Wald test\n3. Output: Results table, MA plot, normalized counts\n\nData: Simulated yeast RNA-seq count data (60 genes, 6 samples: 3 control + 3 treated).\nRequires: R + DESeq2 + ggplot2 + readr"
      },
      "ui": {
        "title": "Notes",
        "color": "#f59e0b"
      }
    },
    {
      "id": "counts_001",
      "type": "input_file",
      "position": [
        80,
        80
      ],
      "params": {
        "file": "examples/data/biopython/deseq2_counts.csv"
      },
      "ui": {
        "title": "Count Matrix"
      }
    },
    {
      "id": "samples_001",
      "type": "input_file",
      "position": [
        80,
        234
      ],
      "params": {
        "file": "examples/data/biopython/deseq2_sample_info.csv"
      },
      "ui": {
        "title": "Sample Info"
      }
    },
    {
      "id": "deseq2_001",
      "type": "deseq2_analysis",
      "position": [
        440,
        80
      ],
      "params": {
        "design_formula": "~ condition",
        "contrast": "condition,treated,control",
        "min_counts": 10,
        "lfc_threshold": 0.0,
        "padj_threshold": 0.05
      },
      "ui": {
        "title": "DESeq2 Analysis"
      }
    },
    {
      "id": "heatmap_001",
      "type": "r_pheatmap",
      "position": [
        800,
        80
      ],
      "params": {
        "scale": "row",
        "annotation_csv": "examples/data/biopython/heatmap_annotation.csv",
        "cluster_rows": true,
        "cluster_cols": true,
        "show_rownames": true,
        "show_colnames": true,
        "fontsize": 10,
        "width": 900,
        "height": 700
      },
      "ui": {
        "title": "DE Heatmap"
      }
    },
    {
      "id": "volcano_001",
      "type": "volcano_plot",
      "position": [
        800,
        320
      ],
      "params": {
        "title": "DESeq2 Volcano Plot",
        "format": "png",
        "logfc_column": "log2FoldChange",
        "pvalue_column": "padj"
      },
      "ui": {
        "title": "Volcano Plot"
      }
    },
    {
      "id": "ma_plot_001",
      "type": "ma_plot",
      "position": [
        800,
        560
      ],
      "params": {
        "title": "DESeq2 MA Plot",
        "format": "png",
        "mean_column": "baseMean",
        "logfc_column": "log2FoldChange",
        "pvalue_column": "padj"
      },
      "ui": {
        "title": "MA Plot"
      }
    },
    {
      "id": "de_report_001",
      "type": "html_report",
      "position": [
        1160,
        320
      ],
      "params": {
        "title": "DESeq2 Differential Expression Report",
        "text_sections": "# Summary\nDifferential expression results with volcano visualization and result table.",
        "section_names": "Volcano plot,DESeq2 results"
      },
      "ui": {
        "title": "DE Report"
      }
    },
    {
      "id": "ma_preview_001",
      "type": "image_preview",
      "position": [
        1160,
        560
      ],
      "params": {},
      "ui": {
        "title": "View MA Plot"
      }
    },
    {
      "id": "heatmap_preview_001",
      "type": "image_preview",
      "position": [
        1160,
        80
      ],
      "params": {},
      "ui": {
        "title": "View Heatmap"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "counts_001",
        "output": "file"
      },
      "to": {
        "node": "deseq2_001",
        "input": "count_matrix"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "samples_001",
        "output": "file"
      },
      "to": {
        "node": "deseq2_001",
        "input": "sample_info"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "deseq2_001",
        "output": "normalized_counts_csv"
      },
      "to": {
        "node": "heatmap_001",
        "input": "data_csv"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "deseq2_001",
        "output": "results_csv"
      },
      "to": {
        "node": "volcano_001",
        "input": "results_table"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "deseq2_001",
        "output": "results_csv"
      },
      "to": {
        "node": "ma_plot_001",
        "input": "results_table"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "volcano_001",
        "output": "volcano_image"
      },
      "to": {
        "node": "de_report_001",
        "input": "images"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "deseq2_001",
        "output": "results_csv"
      },
      "to": {
        "node": "de_report_001",
        "input": "tables"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "ma_plot_001",
        "output": "ma_image"
      },
      "to": {
        "node": "ma_preview_001",
        "input": "file"
      }
    },
    {
      "id": "e9",
      "from": {
        "node": "heatmap_001",
        "output": "plot_png"
      },
      "to": {
        "node": "heatmap_preview_001",
        "input": "file"
      }
    }
  ],
  "groups": [],
  "outputs": {
    "deseq2_results": "deseq2_001",
    "volcano_plot": "volcano_001",
    "ma_plot": "ma_plot_001",
    "heatmap": "heatmap_001",
    "report": "de_report_001"
  }
}
